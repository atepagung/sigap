<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Use case: satu kelas per tindakan (KirimAsesmen, VerifikasiLaporan), bukan satu service
    besar per domain. Di sinilah lapis 2 (Scope) DIPILIH — GetScope(permission) — lalu
    diteruskan ke port kueri yang menerapkannya di klausa WHERE (Infrastructure). DTO respons
    ditandai [Sieve] untuk lapis 3.

    Ketergantungan ke Kemenkeu.Iam DISENGAJA dan tidak dibungkus abstraksi sendiri:
    membungkusnya berarti mencerminkan DataScope dengan tipe kita, dan itu sama dengan
    menyalin logika keamanan yang Lampiran A larang. Yang boleh dipakai dari sini hanya
    ABSTRAKSINYA (ICurrentUserContext, DataScope, ApplyScope, [Sieve]) — perakitannya
    (AddKemenkeuIam, JwtBearer) tetap di layer Api.
  -->

  <PropertyGroup>
    <RootNamespace>Sigap.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sigap.Domain/Sigap.Domain.csproj" />
    <ProjectReference Include="../../../../libs/iam-dummy/src/Kemenkeu.Iam.Dummy/Kemenkeu.Iam.Dummy.csproj" />
    <ProjectReference Include="../../../../libs/notifikasi/src/Sigap.Notifikasi/Sigap.Notifikasi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sigap.Application.Tests" />
  </ItemGroup>

</Project>
