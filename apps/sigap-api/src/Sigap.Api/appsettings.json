{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Kosong dengan sengaja. Di lingkungan selain development diisi environment variable
  // ConnectionStrings__Sigap dari vault — tidak pernah ditulis di berkas yang masuk git.
  // Proses menolak mulai bila nilainya kosong.
  "ConnectionStrings": {
    "Sigap": ""
  },

  // Keamanan tiga lapis — dibaca iam.plugin (saat ini libs/iam-dummy).
  "Iam": {
    "Authority": "",
    "Audience": "sigap-api",
    "PolicyFile": "iam-policy.sigap.json",
    "RequireHttpsMetadata": true
  },

  "Notifikasi": {
    // "web-push" baru boleh ditambahkan setelah port IGudangLanggananPush dan
    // IPengirimWebPush terisi (P4.2/P5.3); tanpa itu proses gagal saat mulai.
    "Kanal": [ "dalam-aplikasi" ],
    "WebPush": {
      // Menunggu jawaban BaTII atas Lampiran E #13.
      "Aktif": false,
      "Subjek": "mailto:organta@kemenkeu.go.id",
      "TtlDetik": 3600
      // KunciPublik & KunciPrivat TIDAK pernah ditulis di sini —
      // lewat environment variable atau vault (aturan mutlak proyek no. 4).
    }
  }
}
