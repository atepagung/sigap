{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // PostgreSQL docker compose (docker-compose.yml, layanan "postgres"). Nilai-nilai ini disalin
  // dari berkas itu — kredensial lokal pengembangan, bukan kredensial platform. Port host 5433,
  // bukan 5432: lihat catatan di docker-compose.yml. Pasang skemanya lebih dulu:
  //   node infra/skema/terapkan.mjs --yes-development
  "ConnectionStrings": {
    "Sigap": "Host=localhost;Port=5433;Database=sigap_dev;Username=sigap_app;Password=sigap_password",
    "Redis": "localhost:6379"
  },

  // MinIO lokal (docker-compose.yml, layanan "minio", konsol http://localhost:9001). Kredensial
  // dev, bukan rahasia asli — sama seperti password PostgreSQL di atas. Bucket dibuat otomatis
  // saat proses mulai bila belum ada (lihat PenyimpanLampiranS3 / catatan README).
  "Lampiran": {
    "Driver": "s3",
    "S3": {
      "Endpoint": "http://localhost:9000",
      "Bucket": "sigap-lampiran",
      "AccessKey": "minioadmin",
      "SecretKey": "miniopassword"
    }
  },

  "Iam": {
    // Keycloak lokal (P3.4) — jalankan dengan: docker compose --profile sso up
    "Authority": "http://localhost:8081/realms/kemenkeu",
    "RequireHttpsMetadata": false
  },

  "Notifikasi": {
    // Port notifikasi diisi versi dalam memori dari libs/notifikasi-dummy, sehingga
    // "web-push" sudah dapat ikut dijalankan. Kanalnya sendiri tetap melaporkan dirinya
    // nonaktif selama kunci VAPID belum ada — itu memang yang ingin dilihat.
    "Kanal": [ "dalam-aplikasi", "web-push", "log" ]
  }
}
