# sigap-api — environment variable per lingkungan. TANPA NILAI: diisi dari vault, tidak pernah di-commit.
# Nama memakai "__" sebagai pemisah bagian konfigurasi .NET (Iam__Authority = "Iam:Authority").
# Bawaan yang aman ada di src/Sigap.Api/appsettings.json; yang tercantum di sini wajib atau lazim diganti per
# lingkungan. Manifest sigap-dev memuatnya dari Secret "sigap-api-env" (infra/k8s/sigap-dev/sigap-api.yaml).

# ── Wajib ────────────────────────────────────────────────────────────────────────────────────────────
# Connection string PostgreSQL (skema: infra/skema). Proses menolak mulai bila kosong. RAHASIA.
ConnectionStrings__Sigap=
# Issuer OIDC SSO Kemenkeu, mis. realm Keycloak. Dibaca iam.plugin (saat ini libs/iam-dummy).
Iam__Authority=
# Nama lingkungan .NET. Di cluster: Production (Development membuka OpenAPI, CORS localhost, banner dummy).
ASPNETCORE_ENVIRONMENT=

# ── Lampiran (object storage) ───────────────────────────────────────────────────────────────────────
# "s3" di cluster: lebih dari satu replika dan tanpa persistent volume, jadi driver "disk" tidak dapat dipakai.
Lampiran__Driver=
# Alamat layanan S3 (MinIO/object storage platform). Wajib bila driver "s3".
Lampiran__S3__Endpoint=
# Nama bucket. Bawaan: sigap-lampiran.
Lampiran__S3__Bucket=
# Kredensial object storage. RAHASIA.
Lampiran__S3__AccessKey=
Lampiran__S3__SecretKey=
# Hanya bila driver "disk" (pengembangan): folder penyimpanan.
Lampiran__Folder=

# ── Cache ───────────────────────────────────────────────────────────────────────────────────────────
# Redis untuk cache data publik BMKG/BNPB (kunci berawalan "sigap:"). Kosong = cache di memori tiap replika.
# RAHASIA bila memuat kata sandi.
ConnectionStrings__Redis=

# ── Keamanan (iam.plugin) ───────────────────────────────────────────────────────────────────────────
# Audience token. Bawaan: sigap-api.
Iam__Audience=
# false hanya untuk issuer http di pengembangan. Bawaan: true.
Iam__RequireHttpsMetadata=

# ── Notifikasi ──────────────────────────────────────────────────────────────────────────────────────
# Daftar kanal, satu per indeks. Bawaan: dalam-aplikasi saja. "web-push" menunggu Lampiran E #13.
Notifikasi__Kanal__0=
Notifikasi__Kanal__1=
# Web Push: aktif hanya setelah Lampiran E #13 terjawab.
Notifikasi__WebPush__Aktif=
# Kunci VAPID (base64url). Publik boleh diketahui peramban; privat RAHASIA. Tidak pernah ditulis di appsettings.
Notifikasi__WebPush__KunciPublik=
Notifikasi__WebPush__KunciPrivat=
# Kontak pengirim VAPID (mailto:...).
Notifikasi__WebPush__Subjek=
# Host peladen push tambahan yang boleh dikirimi (bawaan: FCM, Mozilla, Apple, Windows).
Notifikasi__WebPush__HostDiizinkan__0=

# ── Integrasi BMKG/BNPB ─────────────────────────────────────────────────────────────────────────────
# Pemicu Safety Check otomatis. Bawaan: false — menyalakannya keputusan penempatan (ACCESS_RULES A11).
Bmkg__Aktif=
# NIP akun layanan pengirim broadcast otomatis. Bawaan: SISTEM-BMKG.
Bmkg__NipLayanan=
# Plafon permintaan/menit ke BMKG dari SATU replika. Batas BMKG 60/menit per IP: bagi dengan jumlah replika
# yang keluar lewat satu IP. Bawaan: 50.
Bmkg__BatasPermintaanPerMenit=
# Info bencana terkini (#48). Bawaan: true.
InfoBencana__Aktif=
# Kompilasi tahunan BNPB; ganti saat kompilasi tahun baru terbit.
InfoBencana__ResourceIdRekapBnpb=
