# sigap-web — environment variable container, TANPA NILAI. Ditulis ke config.json saat container mulai
# (docker/40-sigap-config.sh) dan dibaca aplikasi sebelum bootstrap (src/app/core/config/konfigurasi-runtime.ts).
# SEMUA NILAI DI SINI TERBACA PERAMBAN — jangan pernah menaruh rahasia. Manifest sigap-dev memuatnya dari
# ConfigMap "sigap-web-env" (infra/k8s/sigap-dev/sigap-web.yaml).
# [ASUMSI] sementara sampai shell/starter.mfe menyerahkan konfigurasi resmi (Lampiran E #12).

# Wajib. Alamat sigap-api yang dijangkau PERAMBAN (bukan alamat antar-pod), tanpa garis miring akhir.
# Container menolak mulai bila kosong.
API_BASE_URL=
# Issuer OIDC untuk login mode mandiri (seam pengembangan, DUMMY_REGISTRY butir 51). Kosong = bawaan lokal.
SSO_ISSUER_URL=
# Client OIDC login mode mandiri. Kosong = bawaan lokal.
SSO_CLIENT_ID=
# Kunci PUBLIK VAPID (base64url), sama dengan Notifikasi__WebPush__KunciPublik di sigap-api. Kosong = Web Push
# belum diaktifkan.
VAPID_PUBLIC_KEY=
