# Salin menjadi .env — atau lebih baik jalankan:  node infra/keycloak/buat-env.mjs
# (mengisi nilai acak lokal). Jangan pernah memakai nilai yang mirip kredensial asli.

# Admin konsol Keycloak dummy (http://localhost:8081)
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Satu kata sandi untuk kesepuluh akun uji realm kemenkeu (username = NIP uji, lihat infra/keycloak/README.md)
SIGAP_UJI_PASSWORD=

# Secret client sigap-api-dev (di platform asli: dari vault)
SIGAP_API_DEV_CLIENT_SECRET=
