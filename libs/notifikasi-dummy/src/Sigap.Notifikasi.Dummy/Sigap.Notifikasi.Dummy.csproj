<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DUMMY. Tercatat di DUMMY_REGISTRY.md bagian 1.8. Tidak boleh naik ke production.

    Isinya hanya yang memang tidak punya padanan sungguhan selama pengembangan: kanal log,
    serta implementasi dalam memori bagi port yang basis datanya baru ada di P4.2.
